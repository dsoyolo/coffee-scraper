# AWS region for DynamoDB and deployment
AWS_REGION=eu-west-1

# DynamoDB table names (defaults match CDK stack)
DYNAMO_PRODUCTS_TABLE=coffee-products
DYNAMO_HISTORY_TABLE=coffee-price-history

# For local DynamoDB (e.g. with `docker run amazon/dynamodb-local`)
# DYNAMO_ENDPOINT_URL=http://localhost:8000

# Frontend: point at local backend during development
VITE_API_URL=http://localhost:8000/api
